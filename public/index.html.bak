<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Runa / CookieChat</title>
  <link rel="stylesheet" href="style.css">
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="theme-runa-dark">

  <!-- ==================== ЭКРАН АКТИВАЦИИ APPLE MACBOOK ==================== -->
  <div id="mac-activation-screen">
    <div class="activation-window">
      <div class="mac-titlebar">
        <div class="traffic-lights">
          <span class="light red"></span>
          <span class="light yellow"></span>
          <span class="light green"></span>
        </div>
        <span class="titlebar-caption">Ассистент настройки Mac</span>
      </div>
      
      <div class="activation-body">
        <div class="apple-hero-logo">
          <svg viewBox="0 0 170 170" width="64" height="64" fill="currentColor">
            <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.04-7.7-7.91-12-14.6-6.3-9.78-11.23-20.91-14.79-33.39-3.56-12.49-5.34-24.19-5.34-35.11 0-14.57 3.52-26.68 10.57-36.33 7.05-9.65 16.03-14.61 26.93-14.88 5.11 0 10.57 1.25 16.39 3.75 5.82 2.5 9.78 3.75 11.89 3.75 1.9 0 5.86-1.25 11.88-3.75 6.02-2.5 11.19-3.64 15.52-3.41 12.27.67 22.04 5.39 29.31 14.16-10.74 6.52-16 15.44-15.79 26.77.21 8.91 3.57 16.42 10.08 22.52 6.51 6.1 14.3 9.61 23.36 10.52-2.12 6.53-4.78 13.17-7.98 19.92zM119.22 31.85c0-7.28 2.66-14.07 7.99-20.37 5.33-6.3 11.87-10.43 19.63-12.38.22 1.09.33 2.07.33 2.94 0 7.07-2.78 13.97-8.33 20.7-5.55 6.74-12.21 10.65-19.98 11.75-.11-.87-.22-1.74-.22-2.64z"/>
          </svg>
        </div>
        <h1 id="act-header">Добро пожаловать в CookieChat</h1>
        <p class="act-subtext">Войдите с помощью своего Apple ID или активируйте новую учётную запись на этом Mac.</p>

        <form id="activation-form">
          <div class="act-field-group" id="act-name-box" style="display: none;">
            <input type="text" id="act-fullname" placeholder="Ваше имя (Отображаемое)">
          </div>
          <div class="act-field-group">
            <input type="text" id="act-username" placeholder="Имя пользователя (@handle)" required autocomplete="off">
          </div>
          <div class="act-field-group">
            <input type="password" id="act-password" placeholder="Пароль" required>
          </div>

          <div class="act-buttons">
            <button type="button" class="act-btn secondary" id="act-switch-mode">Создать новую учётную запись</button>
            <button type="submit" class="act-btn primary" id="act-submit-btn">Продолжить</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ==================== ОСНОВНОЙ ИНТЕРФЕЙС RUNA ==================== -->
  <div id="main-app" style="display: none;">
    
    <!-- ВЕРХНЯЯ СИСТЕМНАЯ ПАНЕЛЬ -->
    <header class="app-topbar">
      <div class="topbar-left">
        <button class="menu-burger-btn" id="toggle-drawer-btn" title="Меню">
          <i data-lucide="menu"></i>
        </button>
        <div class="user-chip" id="topbar-user-badge">
          <div class="avatar-circle-sm" id="topbar-avatar">T</div>
          <div class="user-chip-text">
            <span class="chip-name" id="topbar-name">test</span>
            <span class="chip-username" id="topbar-username">@dfsadsa</span>
          </div>
        </div>
      </div>

      <div class="topbar-right">
        <button class="top-action-pill" id="download-app-btn">
          <i data-lucide="download"></i>
          <span>Скачать приложение</span>
        </button>
        <button class="logout-icon-btn" id="logout-btn" title="Выйти">
          <i data-lucide="log-out"></i>
        </button>
      </div>
    </header>

    <!-- РАБОЧЕЕ ПРОСТРАНСТВО -->
    <div class="app-workspace">
      
      <!-- ЛЕВАЯ КОЛОНКА: ЧАТЫ -->
      <section class="chats-sidebar">
        <div class="chats-header-row">
          <h2 class="chats-heading">Чаты</h2>
          <div class="chats-filter-icons">
            <button class="filter-icon" id="btn-filter-saved"><i data-lucide="bookmark"></i></button>
            <button class="filter-icon" id="btn-filter-groups"><i data-lucide="users"></i></button>
            <button class="filter-icon" id="btn-filter-channels"><i data-lucide="megaphone"></i></button>
          </div>
        </div>

        <div class="search-container">
          <input type="text" id="chats-search-input" placeholder="Поиск">
        </div>

        <!-- ИСТОРИИ / СТОРИС СВЕРХУ -->
        <div class="stories-strip">
          <div class="story-item my-story">
            <div class="story-avatar-wrap">
              <div class="avatar-circle-md" id="story-my-avatar">T</div>
              <span class="add-story-plus">+</span>
            </div>
            <span class="story-author">Моя</span>
          </div>
          <div class="story-item">
            <div class="story-avatar-wrap active-ring">
              <div class="avatar-circle-md bg-ceo">C</div>
            </div>
            <span class="story-author">ceo runa</span>
          </div>
        </div>

        <!-- СПИСОК ЧАТОВ -->
        <div class="chats-list" id="chats-list-container"></div>
      </section>

      <!-- ПРАВАЯ ОБЛАСТЬ: ЧАТ / ПУСТОЙ ЭКРАН С ПАТТЕРНОМ -->
      <main class="chat-main-view" id="chat-stage">
        <div class="empty-pattern-slate" id="chat-unselected">
          <p class="empty-slate-text">Выберите чат, чтобы начать переписку</p>
        </div>

        <div class="chat-viewport" id="chat-opened" style="display: none;">
          <div class="chat-top-header">
            <div class="chat-top-details">
              <h3 id="opened-chat-title">Название чата</h3>
              <span class="chat-top-status" id="opened-chat-status">в сети</span>
            </div>
          </div>
          <div class="messages-stream" id="chat-messages-stream"></div>
          <div class="chat-input-bar">
            <input type="file" id="media-file-input" style="display: none;">
            <button class="input-action-btn" id="btn-attach"><i data-lucide="paperclip"></i></button>
            <textarea id="composer-textarea" rows="1" placeholder="Написать сообщение..."></textarea>
            <button class="send-message-btn" id="btn-send"><i data-lucide="arrow-up"></i></button>
          </div>
        </div>
      </main>

    </div>
  </div>

  <!-- ==================== ВЫДВИЖНОЕ МЕНЮ (БОКОВАЯ ШТОРКА СО СКРИНШОТА 2) ==================== -->
  <div class="drawer-overlay" id="drawer-overlay" style="display: none;">
    <aside class="runa-drawer">
      <div class="drawer-user-card" id="drawer-user-card-btn">
        <div class="avatar-circle-md" id="drawer-avatar">T</div>
        <div class="drawer-user-info">
          <span class="drawer-name" id="drawer-name">Мой профиль</span>
          <span class="drawer-handle" id="drawer-username">@dfsadsa</span>
        </div>
      </div>

      <nav class="drawer-nav-list">
        <button class="drawer-nav-item" id="nav-feed">
          <div class="nav-icon-bg blue"><i data-lucide="newspaper"></i></div>
          <span class="nav-title">Лента</span>
          <i data-lucide="chevron-right" class="nav-arrow"></i>
        </button>

        <button class="drawer-nav-item" id="nav-chats">
          <div class="nav-icon-bg green"><i data-lucide="message-circle"></i></div>
          <span class="nav-title">Чаты</span>
          <i data-lucide="chevron-right" class="nav-arrow"></i>
        </button>

        <button class="drawer-nav-item" id="nav-notifications">
          <div class="nav-icon-bg orange"><i data-lucide="bell"></i></div>
          <span class="nav-title">Уведомления</span>
          <span class="nav-badge-pill">1</span>
        </button>

        <div class="drawer-divider"></div>

        <button class="drawer-nav-item" id="nav-store">
          <div class="nav-icon-bg purple"><i data-lucide="gift"></i></div>
          <span class="nav-title">Магазин</span>
          <i data-lucide="chevron-right" class="nav-arrow"></i>
        </button>

        <button class="drawer-nav-item" id="nav-market">
          <div class="nav-icon-bg cyan"><i data-lucide="store"></i></div>
          <span class="nav-title">Маркет</span>
          <i data-lucide="chevron-right" class="nav-arrow"></i>
        </button>

        <button class="drawer-nav-item" id="nav-clans">
          <div class="nav-icon-bg slate"><i data-lucide="shield"></i></div>
          <span class="nav-title">Кланы</span>
          <i data-lucide="chevron-right" class="nav-arrow"></i>
        </button>

        <button class="drawer-nav-item" id="nav-premium">
          <div class="nav-icon-bg gold"><i data-lucide="star"></i></div>
          <span class="nav-title">Runa Premium</span>
          <i data-lucide="chevron-right" class="nav-arrow"></i>
        </button>

        <button class="drawer-nav-item" id="nav-rubies">
          <div class="nav-icon-bg ruby-red"><i data-lucide="gem"></i></div>
          <span class="nav-title">Рубины</span>
          <span class="nav-metric" id="drawer-rubies-count">0</span>
        </button>

        <button class="drawer-nav-item" id="nav-wallet">
          <div class="nav-icon-bg mops-bg"><i data-lucide="wallet"></i></div>
          <span class="nav-title">Mops Wallet</span>
          <i data-lucide="chevron-right" class="nav-arrow"></i>
        </button>

        <div class="drawer-divider"></div>

        <button class="drawer-nav-item" id="nav-accounts">
          <div class="nav-icon-bg pink"><i data-lucide="users-2"></i></div>
          <span class="nav-title">Аккаунты</span>
          <i data-lucide="chevron-right" class="nav-arrow"></i>
        </button>

        <button class="drawer-nav-item" id="nav-settings">
          <div class="nav-icon-bg grey"><i data-lucide="sliders-horizontal"></i></div>
          <span class="nav-title">Настройки</span>
          <i data-lucide="chevron-right" class="nav-arrow"></i>
        </button>

        <button class="drawer-nav-item" id="nav-admin" style="display: none;">
          <div class="nav-icon-bg dark-red"><i data-lucide="shield-alert"></i></div>
          <span class="nav-title">Админ Панель</span>
          <i data-lucide="chevron-right" class="nav-arrow"></i>
        </button>
      </nav>
    </aside>
  </div>

  <!-- ==================== КАРТОЧКА ПРОФИЛЯ (СКРИНШОТ 3) ==================== -->
  <div class="modal-backdrop" id="modal-profile-card" style="display: none;">
    <div class="profile-window">
      <div class="window-nav-actions">
        <button class="win-btn" id="btn-edit-profile-open"><i data-lucide="pen-line"></i></button>
        <button class="win-btn close-btn" data-close="modal-profile-card"><i data-lucide="x"></i></button>
      </div>

      <div class="profile-card-content">
        <div class="profile-avatar-giant" id="card-avatar">T</div>
        <h2 class="profile-card-name" id="card-name">test</h2>
        
        <div class="profile-status-badges">
          <span class="level-badge" id="card-level">1</span>
          <span class="status-pill online">в сети</span>
        </div>

        <button class="balance-tag-pill" id="card-balance-pill">
          Баланс: <span class="mops-icon">🐶</span> <span id="card-balance-num">0,00</span>
          <i data-lucide="chevron-right"></i>
        </button>

        <div class="profile-detail-card">
          <div class="detail-row">
            <div class="detail-icon-box blue"><i data-lucide="at-sign"></i></div>
            <div class="detail-text-col">
              <div class="handle-line">
                <span class="handle-val" id="card-username">@dfsadsa</span>
                <i data-lucide="copy" class="copy-handle"></i>
              </div>
              <span class="detail-sub">Имя пользователя</span>
            </div>
          </div>

          <div class="detail-row">
            <div class="detail-icon-box pink"><i data-lucide="clock"></i></div>
            <div class="detail-text-col">
              <span class="reg-date" id="card-regdate">На Runa с 29 окт. 2026 г.</span>
            </div>
          </div>
        </div>

        <div class="profile-badges-row">
          <span class="meta-label">Значки</span>
          <div class="badges-flex" id="card-badges-flex">
            <span class="apple-badge l2">2</span>
            <span class="apple-badge pum">🎃</span>
            <span class="apple-badge ver">🛡️</span>
          </div>
        </div>

        <div class="views-counter">
          <i data-lucide="eye"></i>
          <span>0</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== РЕДАКТИРОВАНИЕ ПРОФИЛЯ (СКРИНШОТ 4) ==================== -->
  <div class="modal-backdrop" id="modal-edit-profile" style="display: none;">
    <div class="edit-profile-window">
      <div class="window-nav-actions">
        <button class="win-btn" id="btn-edit-profile-back"><i data-lucide="chevron-left"></i></button>
        <button class="win-btn close-btn" data-close="modal-edit-profile"><i data-lucide="x"></i></button>
      </div>

      <div class="edit-profile-scrollable">
        <div class="avatar-uploader-center">
          <div class="profile-avatar-giant" id="edit-avatar-preview">T</div>
          <div class="camera-badge-btn"><i data-lucide="camera"></i></div>
        </div>

        <h3 class="section-title-label">Профиль</h3>
        <div class="edit-fields-card">
          <div class="form-row">
            <label>Имя</label>
            <input type="text" id="edit-name-val" value="test">
          </div>
          <div class="form-row">
            <label>Юзернейм</label>
            <div class="username-static-row">
              <span class="static-prefix">@</span>
              <span id="edit-username-val">dfsadsa</span>
            </div>
          </div>
          <div class="form-row">
            <label>Описание</label>
            <div class="with-emoji-btn">
              <input type="text" id="edit-bio-val" placeholder="Пара слов о себе">
              <i data-lucide="smile"></i>
            </div>
          </div>
          <div class="form-row">
            <label>Место</label>
            <input type="text" id="edit-city-val" placeholder="Город или страна">
          </div>
        </div>

        <h3 class="section-title-label">Оформление</h3>
        <button class="customization-nav-card" id="btn-open-customization">
          <div class="custom-card-icon green"><i data-lucide="palette"></i></div>
          <span class="custom-card-title">Кастомизация</span>
          <i data-lucide="chevron-right" class="nav-arrow"></i>
        </button>

        <div class="edit-buttons-dock">
          <button class="dock-btn cancel" data-close="modal-edit-profile">
            <i data-lucide="x-circle"></i> Отмена
          </button>
          <button class="dock-btn save" id="btn-save-profile">
            <i data-lucide="check-circle"></i> Сохранить
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== КАСТОМИЗАЦИЯ И ВИД ПРОФИЛЯ (СКРИНШОТЫ 5 И 6) ==================== -->
  <div class="modal-backdrop" id="modal-customization" style="display: none;">
    <div class="customization-window">
      <!-- САЙДБАР КАСТОМИЗАЦИИ -->
      <aside class="custom-sidebar">
        <div class="custom-sidebar-header">
          <button class="win-btn mini close-btn" data-close="modal-customization"><i data-lucide="x"></i></button>
          <div class="custom-search">
            <i data-lucide="search"></i>
            <input type="text" placeholder="Поиск">
          </div>
        </div>

        <div class="custom-user-summary">
          <div class="avatar-circle-sm">T</div>
          <div>
            <div class="summary-name" id="custom-user-name">test</div>
            <div class="summary-sub">Кастомизация</div>
          </div>
        </div>

        <div class="custom-nav-sections">
          <span class="category-header">Внешность</span>
          <button class="custom-tab-btn active" data-tab="tab-avatar"><i data-lucide="user"></i> Аватар</button>
          <button class="custom-tab-btn" data-tab="tab-banner"><i data-lucide="image"></i> Баннер</button>
          <button class="custom-tab-btn" data-tab="tab-style"><i data-lucide="layout"></i> Вид профиля</button>
          <button class="custom-tab-btn" data-tab="tab-frame"><i data-lucide="circle-dot"></i> Рамка аватарки</button>
          <button class="custom-tab-btn" data-tab="tab-bg"><i data-lucide="paint-bucket"></i> Фон профиля</button>

          <span class="category-header">Имя</span>
          <button class="custom-tab-btn" data-tab="tab-nick"><i data-lucide="type"></i> Никнейм</button>
          <button class="custom-tab-btn" data-tab="tab-nft-color"><i data-lucide="palette"></i> Цвет юзернеймов</button>

          <span class="category-header">Знаки</span>
          <button class="custom-tab-btn" data-tab="tab-lvl"><i data-lucide="shield"></i> Значок уровня</button>
          <button class="custom-tab-btn" data-tab="tab-badges"><i data-lucide="award"></i> Значки</button>

          <span class="category-header">Коллекция</span>
          <button class="custom-tab-btn" data-tab="tab-nfts"><i data-lucide="at-sign"></i> Юзернеймы</button>
          <button class="custom-tab-btn" data-tab="tab-phone"><i data-lucide="phone"></i> Номер</button>
        </div>
      </aside>

      <!-- ЦЕНТР НАСТРОЕК -->
      <section class="custom-center-settings">
        <!-- ВКЛАДКА: АВАТАР -->
        <div class="custom-view-panel" id="tab-avatar">
          <div class="settings-head-card">
            <div class="head-icon orange"><i data-lucide="user"></i></div>
            <div>
              <h4>Аватар</h4>
              <p>Ваша аватарка: как она выглядит и какие были раньше.</p>
            </div>
          </div>

          <div class="avatar-preview-box">
            <div class="avatar-placeholder-circle">
              <span>Пока не поставлено</span>
            </div>
            <h3 class="preview-name-label" id="custom-preview-name-1">test</h3>
          </div>

          <div class="controls-card">
            <span class="control-group-title">Кадр</span>
            <div class="slider-row">
              <label>Масштаб</label>
              <input type="range" min="50" max="200" value="100" class="mac-slider">
              <span class="slider-val">100%</span>
            </div>
            <div class="toggle-row">
              <label>Отразить</label>
              <input type="checkbox" class="mac-switch">
            </div>

            <span class="control-group-title" style="margin-top: 15px;">Свет и цвет</span>
            <div class="slider-row">
              <label>Яркость</label>
              <input type="range" min="0" max="200" value="135" class="mac-slider purple">
              <span class="slider-val">135%</span>
            </div>
            <div class="slider-row">
              <label>Контраст</label>
              <input type="range" min="0" max="200" value="150" class="mac-slider purple">
              <span class="slider-val">150%</span>
            </div>
            <div class="slider-row">
              <label>Насыщенность</label>
              <input type="range" min="0" max="200" value="100" class="mac-slider purple">
              <span class="slider-val">100%</span>
            </div>
            <div class="slider-row">
              <label>Теплота</label>
              <input type="range" min="-100" max="100" value="100" class="mac-slider purple">
              <span class="slider-val">+100</span>
            </div>

            <div class="controls-actions">
              <button class="mac-btn secondary"><i data-lucide="rotate-ccw"></i> Сбросить</button>
              <button class="mac-btn primary-purple"><i data-lucide="check"></i> Сохранить</button>
            </div>
          </div>
        </div>

        <!-- ВКЛАДКА: ВИД ПРОФИЛЯ -->
        <div class="custom-view-panel" id="tab-style" style="display: none;">
          <div class="settings-head-card">
            <div class="head-icon blue"><i data-lucide="layout"></i></div>
            <div>
              <h4>Вид профиля</h4>
              <p>Как нарисована ваша карточка профиля. Её так видят все, кто её открыл.</p>
            </div>
          </div>

          <div class="profile-cards-grid">
            <div class="style-choice-item" data-style="runa">
              <div class="style-mockup runa-mock"></div>
              <span>Runa</span>
            </div>
            <div class="style-choice-item active" data-style="telegram">
              <div class="style-mockup telegram-mock"></div>
              <span>Telegram</span>
            </div>
            <div class="style-choice-item" data-style="discord">
              <div class="style-mockup discord-mock"></div>
              <span>Discord</span>
            </div>
            <div class="style-choice-item" data-style="twitter">
              <div class="style-mockup twitter-mock"></div>
              <span>Twitter</span>
            </div>
            <div class="style-choice-item" data-style="steam">
              <div class="style-mockup steam-mock"></div>
              <span>Steam</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ПРАВЫЙ ПРЕДПРОСМОТР (КАК НА СКРИНШОТАХ 5 И 6) -->
      <aside class="custom-live-preview">
        <div class="preview-mode-switch">
          <span class="mode-label">Предпросмотр</span>
          <div class="segmented-pill">
            <button class="active">Профиль</button>
            <button>В чате</button>
          </div>
        </div>

        <div class="live-card-mockup" id="live-preview-card">
          <div class="live-avatar-giant">T</div>
          <h3 class="live-name-label" id="live-name">test</h3>
          <div class="live-sub-status">
            <span class="level-mini">1</span>
            <span class="online-dot">в сети</span>
          </div>

          <div class="live-action-buttons">
            <div class="live-btn"><i data-lucide="message-circle"></i><span>Чат</span></div>
            <div class="live-btn"><i data-lucide="bell-off"></i><span>Звук</span></div>
            <div class="live-btn"><i data-lucide="phone"></i><span>Звонок</span></div>
            <div class="live-btn"><i data-lucide="more-horizontal"></i><span>Ещё</span></div>
          </div>

          <div class="live-info-box">
            <div class="info-line">
              <i data-lucide="at-sign" class="cyan-icon"></i>
              <div>
                <span class="handle" id="live-handle">@dfsadsa</span>
                <span class="sub">Имя пользователя</span>
              </div>
            </div>
            <div class="info-line">
              <i data-lucide="clock" class="pink-icon"></i>
              <div>
                <span class="reg-date">На Runa с 29 окт. 2026 г.</span>
              </div>
            </div>
          </div>

          <div class="live-badges-strip">
            <span class="mini-badge-icon">2</span>
            <span class="mini-badge-icon">🎃</span>
            <span class="mini-badge-icon">🛡️</span>
          </div>

          <div class="live-views">
            <i data-lucide="eye"></i> 0
          </div>
        </div>
        <p class="preview-disclaimer">Так вас видят все, кто открыл профиль</p>
      </aside>
    </div>
  </div>

  <!-- ==================== MOPS WALLET (СКРИНШОТ 7) ==================== -->
  <div class="modal-backdrop" id="modal-wallet" style="display: none;">
    <div class="wallet-window">
      <div class="wallet-topbar">
        <button class="win-btn close-btn" data-close="modal-wallet"><i data-lucide="chevron-left"></i></button>
        <div class="wallet-header-title">
          <span>🐶 Mops Wallet</span>
          <i data-lucide="badge-check" class="verified-icon"></i>
        </div>
        <div style="width: 32px;"></div>
      </div>

      <div class="wallet-body">
        <!-- БАНКОВСКАЯ КАРТА RUNA -->
        <div class="runa-metal-card">
          <div class="card-top">
            <div class="card-brand">
              <span class="mops-avatar-ico">🐶</span>
              <div class="brand-titles">
                <span class="b-main">Runa</span>
                <span class="b-sub">CARD</span>
              </div>
            </div>
            <div class="card-chip"></div>
          </div>

          <div class="card-bottom">
            <div class="balance-mops-display">
              <span class="num" id="wallet-mops-val">0,00</span>
              <span class="cur">MOPS</span>
            </div>
            <span class="card-holder" id="wallet-card-holder">@dfsadsa</span>
          </div>
        </div>

        <div class="rubies-estimate">
          <span>≈ <strong id="wallet-rubies-est">0</strong> рубинов</span>
          <i data-lucide="pencil" class="edit-est"></i>
        </div>

        <div class="wallet-action-pills">
          <button class="action-pill"><i data-lucide="arrow-left-right"></i> Обмен</button>
          <button class="action-pill"><i data-lucide="arrow-up-right"></i> Отправить</button>
        </div>

        <div class="toggle-card-row">
          <div>
            <span class="toggle-title">Показывать баланс в профиле</span>
            <p class="toggle-sub">Под именем появится плашка «Баланс». Её увидит каждый, кто откроет ваш профиль.</p>
          </div>
          <input type="checkbox" id="wallet-show-toggle" class="mac-switch" checked>
        </div>

        <div class="history-block">
          <span class="hist-label">ИСТОРИЯ</span>
          <div class="hist-filters">
            <button class="filter-pill active">Все</button>
            <button class="filter-pill">Пришло</button>
            <button class="filter-pill">Ушло</button>
            <button class="filter-pill">Обмены</button>
          </div>
          <p class="empty-feed">Пока пусто</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== РУБИНЫ (СКРИНШОТ 8) ==================== -->
  <div class="modal-backdrop" id="modal-rubies" style="display: none;">
    <div class="rubies-window">
      <div class="wallet-topbar">
        <button class="win-btn close-btn" data-close="modal-rubies"><i data-lucide="chevron-left"></i></button>
        <span class="wallet-header-title">Рубины</span>
        <div style="width: 32px;"></div>
      </div>

      <div class="rubies-body">
        <div class="rubies-card-box">
          <div class="box-top">
            <span class="box-label">Рубины Runa</span>
            <span class="box-user" id="rubies-card-user">@dfsadsa</span>
          </div>
          <div class="ruby-val-row">
            <span class="big-gem">💎</span>
            <span class="gem-num" id="rubies-main-count">0</span>
          </div>
          <span class="box-caption">Ваш баланс</span>

          <div class="rubies-actions-row">
            <button class="ruby-btn red" id="btn-replenish-rubies">
              <span class="plus-circle">+</span> Пополнить
            </button>
            <button class="ruby-btn grey">
              <i data-lucide="shopping-cart"></i> Магазин
            </button>
            <button class="ruby-btn grey">
              <i data-lucide="store"></i> Маркет
            </button>
          </div>
        </div>

        <div class="hist-filters" style="margin-top: 20px;">
          <button class="filter-pill active">Все</button>
          <button class="filter-pill">Зачисления</button>
          <button class="filter-pill">Списания</button>
        </div>
        <p class="empty-feed">Операций пока не было</p>
      </div>
    </div>
  </div>

  <!-- ==================== КЛАНЫ (СКРИНШОТ 9) ==================== -->
  <div class="modal-backdrop" id="modal-clans" style="display: none;">
    <div class="clans-window">
      <div class="wallet-topbar">
        <button class="win-btn close-btn" data-close="modal-clans"><i data-lucide="chevron-left"></i></button>
        <span class="wallet-header-title">Кланы</span>
        <div style="width: 32px;"></div>
      </div>

      <div class="clans-body">
        <div class="clans-hero-card">
          <div class="shields-row">
            <span class="shield-badge purple"><i data-lucide="crown"></i></span>
            <span class="shield-badge red"><i data-lucide="skull"></i></span>
            <span class="shield-badge blue"><i data-lucide="zap"></i></span>
          </div>
          <h3>Создай свой клан</h3>
          <p class="hero-desc">Тег и герб у ника, до 200 участников, свой чат и место в рейтинге.</p>
          <button class="create-clan-green-btn" id="btn-clan-buy">
            Создать за 2 000 💎
          </button>
        </div>

        <div class="clan-nav-cards">
          <button class="clan-action-row">
            <div class="icon-sq orange"><i data-lucide="trophy"></i></div>
            <span>Рейтинг кланов</span>
            <i data-lucide="chevron-right" class="nav-arrow"></i>
          </button>
          <button class="clan-action-row">
            <div class="icon-sq grey"><i data-lucide="search"></i></div>
            <span>Найти клан</span>
            <i data-lucide="chevron-right" class="nav-arrow"></i>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== СИСТЕМНЫЕ НАСТРОЙКИ MACOS (СКРИНШОТ 10) ==================== -->
  <div class="modal-backdrop" id="modal-settings" style="display: none;">
    <div class="settings-mac-window">
      <aside class="settings-sidebar">
        <div class="settings-head-bar">
          <button class="win-btn mini close-btn" data-close="modal-settings"><i data-lucide="x"></i></button>
          <div class="custom-search">
            <i data-lucide="search"></i>
            <input type="text" placeholder="Поиск">
          </div>
        </div>

        <div class="settings-user-card">
          <div class="avatar-circle-sm">T</div>
          <div>
            <div class="s-name" id="settings-user-name">test</div>
            <div class="s-handle" id="settings-user-handle">@dfsadsa</div>
          </div>
        </div>

        <div class="settings-menu-list">
          <button class="s-item"><i data-lucide="globe" class="icon purple"></i> Язык</button>
          <button class="s-item active"><i data-lucide="hand" class="icon blue"></i> Конфиденциальность</button>
          <button class="s-item"><i data-lucide="laptop" class="icon orange"></i> Устройства</button>
          <button class="s-item"><i data-lucide="shield-check" class="icon green"></i> Безопасность</button>

          <div class="drawer-divider"></div>
          <button class="s-item"><i data-lucide="palette" class="icon grey"></i> Оформление</button>
          <button class="s-item"><i data-lucide="type" class="icon cyan"></i> Шрифты</button>
          <button class="s-item"><i data-lucide="zoom-in" class="icon blue"></i> Масштаб</button>
          <button class="s-item"><i data-lucide="mic" class="icon orange"></i> Микрофон</button>
          <button class="s-item"><i data-lucide="bell" class="icon red"></i> Звук уведомлений</button>
        </div>
      </aside>

      <section class="settings-content-pane">
        <div class="settings-pane-header">
          <div class="pane-icon blue"><i data-lucide="hand"></i></div>
          <h3>Конфиденциальность</h3>
        </div>

        <div class="settings-block">
          <span class="block-title">Пересылка сообщений</span>
          <div class="radio-card">
            <label class="radio-row"><input type="radio" name="fwd" checked><span>Все</span></label>
            <label class="radio-row"><input type="radio" name="fwd"><span>Мои контакты</span></label>
            <label class="radio-row"><input type="radio" name="fwd"><span>Никто</span></label>
          </div>
        </div>

        <div class="settings-block">
          <span class="block-title">Кто видит фото профиля</span>
          <div class="radio-card">
            <label class="radio-row"><input type="radio" name="photo" checked><span>Все</span></label>
            <label class="radio-row"><input type="radio" name="photo"><span>Мои контакты</span></label>
            <label class="radio-row"><input type="radio" name="photo"><span>Никто</span></label>
          </div>
        </div>

        <div class="settings-block">
          <div class="block-title-row">
            <span class="block-title">Кто может мне писать</span>
            <span class="premium-tag">Premium</span>
          </div>
          <div class="radio-card">
            <label class="radio-row"><input type="radio" name="write" checked><span>Все</span></label>
            <label class="radio-row locked"><span>Только Premium</span> <i data-lucide="lock"></i></label>
            <label class="radio-row locked"><span>За рубины</span> <i data-lucide="lock"></i></label>
          </div>
        </div>

        <button class="delete-acc-btn">
          <i data-lucide="trash-2"></i> Удалить аккаунт
        </button>
      </section>
    </div>
  </div>

  <!-- ==================== АДМИН-ПАНЕЛЬ С ФУНКЦИЯМИ ==================== -->
  <div class="modal-backdrop" id="modal-admin" style="display: none;">
    <div class="admin-window">
      <div class="wallet-topbar">
        <span class="wallet-header-title">Панель Администратора CookieChat</span>
        <button class="win-btn close-btn" data-close="modal-admin"><i data-lucide="x"></i></button>
      </div>

      <div class="admin-body">
        <div class="admin-controls-bar">
          <input type="text" id="admin-search-users" placeholder="Поиск пользователя по логину...">
        </div>

        <div class="admin-table-scroll">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Имя</th>
                <th>Логин</th>
                <th>Анонимный номер</th>
                <th>Рубины</th>
                <th>MOPS</th>
                <th>Действия</th>
              </tr>
            </thead>
            <tbody id="admin-users-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="app.js"></script>
</body>
</html>